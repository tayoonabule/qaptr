{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qaptr Tauri Shell Probe",
  "version": "0.1.0",
  "identifier": "com.qaptr.u3.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Qaptr Tauri Shell",
        "width": 460,
        "height": 300,
        "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "15.0" }
  }
}
