---
// Small progressive-enhancement script: fades editorial passages in on
// scroll. Content is already visible without this script (see the CSS
// rule that only sets initial opacity 0 under prefers-reduced-motion:
// no-preference), so nothing depends on JavaScript for readability.
---

<script>
  if ("IntersectionObserver" in window) {
    const passages = document.querySelectorAll<HTMLElement>(".passage");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    passages.forEach((passage) => observer.observe(passage));
  } else {
    document.querySelectorAll(".passage").forEach((el) => el.classList.add("is-visible"));
  }
</script>
