---
export interface Props {
  source: "hero" | "footer";
  id: string;
  autoFocus?: boolean;
}

const { source, id, autoFocus = false } = Astro.props;
---

<form class="waitlist-form" method="post" action="/api/waitlist" id={id}>
  <input type="hidden" name="source" value={source} />
  <div class="waitlist-field">
    <label for={`${id}-email`}>Email</label>
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="you@example.com"
      required
      maxlength="254"
      autofocus={autoFocus}
    />
  </div>
  <button class="waitlist-submit" type="submit">Join waitlist</button>
</form>
