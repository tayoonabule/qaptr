---
// A single literal diagram: an arc dial sweeping from "sparse" (one
// capture every 10 minutes) to "detailed" cadence, echoing the
// compositional idea of shopify.design's one dramatic data visualization
// in place of a row of feature icons (see docs/design/website.md).
// Rendered as static inline SVG — no canvas, no WebGL, no image request.
---

<svg
  class="arc-diagram"
  viewBox="0 0 400 240"
  role="img"
  aria-labelledby="arc-title arc-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="arc-title">Capture cadence, from sparse to detailed</title>
  <desc id="arc-desc">
    An arc showing Qaptr's capture cadence ranging from one screenshot every ten minutes in
    sparse mode to a tighter interval once a workflow is being captured in detail.
  </desc>

  <path
    d="M 40 200 A 160 160 0 0 1 360 200"
    fill="none"
    stroke="var(--color-border)"
    stroke-width="1.5"
  ></path>

  {
    Array.from({ length: 25 }).map((_, i) => {
      const angle = Math.PI - (i / 24) * Math.PI;
      const inner = 152;
      const outer = 168;
      const cx = 200 + Math.cos(angle) * inner;
      const cy = 200 - Math.sin(angle) * inner;
      const ox = 200 + Math.cos(angle) * outer;
      const oy = 200 - Math.sin(angle) * outer;
      return (
        <line
          x1={cx.toFixed(2)}
          y1={cy.toFixed(2)}
          x2={ox.toFixed(2)}
          y2={oy.toFixed(2)}
          stroke="var(--color-border)"
          stroke-width={i % 6 === 0 ? "2" : "1"}
        />
      );
    })
  }

  <g class="arc-needle" data-animate="false">
    <line x1="200" y1="200" x2="200" y2="52" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round"
    ></line>
    <circle cx="200" cy="200" r="9" fill="var(--color-accent)"></circle>
  </g>

  <text x="40" y="228" font-family="var(--font-mono)" font-size="11" letter-spacing="0.08em" fill="var(--color-fg-muted)">SPARSE · 10 MIN</text>
  <text x="360" y="228" font-family="var(--font-mono)" font-size="11" letter-spacing="0.08em" fill="var(--color-fg-muted)" text-anchor="end">DETAILED · ~2 MIN</text>
</svg>

<script>
  const needle = document.querySelector<SVGGElement>(".arc-needle");
  if (needle && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            needle.setAttribute("data-animate", "true");
            observer.disconnect();
          }
        }
      },
      { threshold: 0.5 },
    );
    observer.observe(needle);
  } else if (needle) {
    // No IntersectionObserver support: show the end state immediately
    // rather than leaving the needle stuck at rest.
    needle.setAttribute("data-animate", "true");
  }
</script>
