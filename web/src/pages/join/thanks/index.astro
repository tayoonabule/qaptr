---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="You're on the list — Qaptr">
  <section class="status status--success wrap reveal">
    <p class="meta status__eyebrow">Waitlist confirmed</p>
    <h1 class="status__headline">You are on the list.</h1>
    <p class="status__body">
      We will email you when the private beta opens. Nothing else happens between now and then.
    </p>
    <a class="status__link" href="/">Back to the homepage</a>
  </section>
</BaseLayout>
