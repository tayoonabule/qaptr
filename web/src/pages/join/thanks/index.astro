---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="You're on the list — Qaptr">
  <section class="status status--success wrap reveal">
    <p class="meta status__eyebrow">Private beta &middot; macOS</p>
    <h1 class="status__headline">You're on the list.</h1>
    <p class="status__body">
      We'll email you when your invite is ready. Nothing else happens between now and then.
    </p>
    <a class="status__link" href="/">Back to the homepage</a>
  </section>
</BaseLayout>
