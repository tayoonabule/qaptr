---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="That email does not look right — Qaptr">
  <section class="status status--warning wrap reveal">
    <p class="meta status__eyebrow">Private beta &middot; macOS</p>
    <h1 class="status__headline">That email does not look right.</h1>
    <p class="status__body">Check for a typo and try again. It takes one field.</p>

    <form class="retry-form" method="post" action="/api/waitlist">
      <input type="hidden" name="source" value="unknown" />
      <label class="visually-hidden" for="retry-waitlist-email">Email address</label>
      <div class="retry-form__row">
        <input
          id="retry-waitlist-email"
          class="retry-form__input"
          type="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <button class="status__submit" type="submit">Try again</button>
      </div>
    </form>

    <a class="status__link" href="/">Back to the homepage</a>
  </section>

  <script>
    document.getElementById("retry-waitlist-email")?.focus();
  </script>

</BaseLayout>
