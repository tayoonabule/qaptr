---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Too many attempts — Qaptr">
  <section class="status status--warning wrap reveal">
    <p class="meta status__eyebrow">Please wait</p>
    <h1 class="status__headline">Try again in a moment.</h1>
    <p class="status__body">The waitlist is receiving a lot of requests. Your email was not saved yet.</p>
    <a class="status__link" href="/">Back to the homepage</a>
  </section>
</BaseLayout>
