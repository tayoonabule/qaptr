---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Something went wrong — Qaptr">
  <section class="status status--error wrap reveal">
    <p class="meta status__eyebrow">Waitlist unavailable</p>
    <h1 class="status__headline">That did not go through.</h1>
    <p class="status__body">We could not save your email. Please try again in a moment.</p>
    <a class="status__link" href="/">Back to the homepage</a>
  </section>
</BaseLayout>
