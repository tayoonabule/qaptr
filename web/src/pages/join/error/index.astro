---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Something went wrong — Qaptr">
  <section class="status status--error wrap reveal">
    <p class="meta status__eyebrow">Private beta &middot; macOS</p>
    <h1 class="status__headline">Something went wrong on our end.</h1>
    <p class="status__body">Your email was not saved. Please try again in a moment.</p>
    <a class="status__link" href="/">Back to the homepage</a>
  </section>
</BaseLayout>
