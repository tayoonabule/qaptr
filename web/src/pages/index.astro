---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import ArcDial from "../components/ArcDial.astro";
---

<BaseLayout title="Qaptr — private beta for macOS">
  <section class="hero wrap">
    <div class="hero__content">
      <h1 class="hero__headline reveal">Remember what you did without stopping to document it.</h1>
      <p class="hero__subhead reveal">
        Qaptr quietly records the shape of your work on your Mac, then gives you a clear draft to review when you are ready.
      </p>

      <ul class="feature-pills reveal" aria-label="Qaptr product principles">
        <li class="feature-pill feature-pill--orange">
          <ion-icon name="shield-checkmark-outline" aria-hidden="true"></ion-icon>
          Stays on your Mac
        </li>
        <li class="feature-pill feature-pill--green">
          <ion-icon name="camera-outline" aria-hidden="true"></ion-icon>
          Captures in the background
        </li>
        <li class="feature-pill feature-pill--violet">
          <ion-icon name="eye-outline" aria-hidden="true"></ion-icon>
          You approve what leaves
        </li>
      </ul>

      <div class="hero__form reveal">
        <WaitlistForm variant="hero" />
      </div>
    </div>

    <figure class="workspace-preview reveal" aria-labelledby="workspace-preview-caption">
      <div class="workspace-preview__appbar">
        <div class="workspace-preview__brand">
          <span>Qaptr</span>
        </div>
          <span class="workspace-preview__mode"><ion-icon name="laptop-outline" aria-hidden="true"></ion-icon>Local capture</span>
      </div>

      <div class="workspace-preview__body">
        <aside class="workspace-preview__sidebar" aria-label="Illustrative workspace navigation">
          <p class="meta workspace-preview__sidebar-label">Workspace</p>
          <span class="workspace-preview__nav workspace-preview__nav--active"><ion-icon name="albums-outline" aria-hidden="true"></ion-icon>Sessions</span>
          <span class="workspace-preview__nav"><ion-icon name="list-outline" aria-hidden="true"></ion-icon>Review</span>
          <span class="workspace-preview__nav"><ion-icon name="settings-outline" aria-hidden="true"></ion-icon>Settings</span>
          <div class="workspace-preview__sidebar-foot">
            <ion-icon name="shield-outline" aria-hidden="true"></ion-icon>Private on this Mac
          </div>
        </aside>

        <div class="workspace-preview__main">
          <div class="workspace-preview__toolbar">
            <div>
              <p class="meta">Recent session</p>
              <h2>Project brief</h2>
            </div>
            <span class="workspace-preview__status"><ion-icon name="checkmark-circle-outline" aria-hidden="true"></ion-icon>Ready to review</span>
          </div>

          <div class="workspace-preview__summary">
            <div>
              <strong>A clear record of your work.</strong>
              <p>See the sequence, keep the context, decide what to share.</p>
            </div>
          </div>

          <div class="workspace-preview__rows animate-ui-list" aria-label="Illustrative session activity">
            <div class="workspace-preview__row">
              <ion-icon class="workspace-preview__row-marker" name="checkmark-outline" aria-hidden="true"></ion-icon>
              <span>Outlined the project brief</span>
              <span class="meta">Recorded</span>
            </div>
            <div class="workspace-preview__row">
              <ion-icon class="workspace-preview__row-marker" name="checkmark-outline" aria-hidden="true"></ion-icon>
              <span>Checked source notes</span>
              <span class="meta">Recorded</span>
            </div>
            <div class="workspace-preview__row">
              <ion-icon class="workspace-preview__row-marker" name="checkmark-outline" aria-hidden="true"></ion-icon>
              <span>Mapped the next step</span>
              <span class="meta">Recorded</span>
            </div>
          </div>
          <p class="workspace-preview__sample meta"><ion-icon name="document-text-outline" aria-hidden="true"></ion-icon>Illustrative preview</p>
        </div>
      </div>
      <figcaption id="workspace-preview-caption" class="workspace-preview__caption">
        Qaptr does not share anything without your approval.
      </figcaption>
    </figure>
  </section>

  <section class="dial-section blueprint-surface radiant-fluid reveal">
    <div class="wrap dial-section__inner">
      <div class="dial-section__intro">
        <p class="meta"><ion-icon name="timer-outline" aria-hidden="true"></ion-icon>Set it once</p>
        <h2>Capture at your pace.</h2>
        <p>Choose how often Qaptr checks in. Keep working. It will build the record quietly.</p>
      </div>
      <div class="dial-section__visual">
        <ArcDial />
        <p class="meta dial-section__caption">
          Choose an interval from 5 seconds to 5 minutes. Change it when your work changes.
        </p>
      </div>
    </div>
  </section>

  <section class="product-bento wrap reveal" aria-labelledby="product-bento-title">
    <div class="product-bento__intro">
      <div class="product-bento__intro-copy">
        <p class="meta">From activity to clarity</p>
        <h2 id="product-bento-title">A useful record, not a replay.</h2>
        <p>Qaptr turns the shape of your work into a short, readable timeline you can check before you report, hand off, or share.</p>
      </div>
      <div class="product-bento__intro-visual" aria-hidden="true">
        <div class="intro-visual__header">
          <span>Session record</span>
          <span>Ready to review</span>
        </div>
        <div class="intro-visual__row">
          <ion-icon name="camera-outline"></ion-icon>
          <span>Work captured</span>
          <b>09:42</b>
        </div>
        <div class="intro-visual__row">
          <ion-icon name="document-text-outline"></ion-icon>
          <span>Context organized</span>
          <b>10:18</b>
        </div>
        <div class="intro-visual__row">
          <ion-icon name="checkmark-outline"></ion-icon>
          <span>Ready to share</span>
          <b>11:06</b>
        </div>
      </div>
    </div>

    <div class="product-bento__grid">
      <article class="product-card passage product-card--capture">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="time-outline" aria-hidden="true"></ion-icon>Capture</p>
          <h3>Your work, captured as it happens.</h3>
          <p>Qaptr records the apps and windows that make up your session, so you do not have to reconstruct the day later.</p>
        </div>
        <div class="mini-timeline" aria-hidden="true">
          <span class="mini-timeline__line"></span>
          <span class="mini-timeline__event mini-timeline__event--one"><b>09:42</b> Outlined the brief</span>
          <span class="mini-timeline__event mini-timeline__event--two"><b>10:18</b> Checked source notes</span>
          <span class="mini-timeline__event mini-timeline__event--three"><b>11:06</b> Mapped next step</span>
        </div>
      </article>

      <article class="product-card passage product-card--privacy">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon>Privacy</p>
          <h3>Private until you say otherwise.</h3>
          <p>Your capture stays on this Mac. Nothing is shared automatically.</p>
        </div>
          <div class="privacy-orbit" aria-hidden="true">
          <span class="privacy-orbit__ring"></span>
          <span class="privacy-orbit__lock"><ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon></span>
          <span class="privacy-orbit__label">Private on this Mac</span>
          </div>
          <details class="animate-ui-accordion">
            <summary>What stays local?</summary>
            <p>Capture remains on this Mac until you choose what belongs in a record.</p>
          </details>
      </article>

      <article class="product-card passage product-card--document">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="document-text-outline" aria-hidden="true"></ion-icon>Review</p>
          <h3>Know what happened before you explain it.</h3>
          <p>Open a clear timeline when you need the context, not a pile of screenshots.</p>
        </div>
        <div class="mini-document" aria-hidden="true">
          <span class="mini-document__bar mini-document__bar--wide"></span>
          <span class="mini-document__bar"></span>
          <span class="mini-document__bar mini-document__bar--short"></span>
          <span class="mini-document__rule"></span>
          <span class="mini-document__tag">ready to review</span>
        </div>
      </article>

      <article class="product-card product-card--handoff">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="share-social-outline" aria-hidden="true"></ion-icon>Share</p>
          <h3>Share the result, not the whole day.</h3>
          <p>Choose the useful parts and turn them into notes for a teammate, a review, or tomorrow.</p>
        </div>
        <div class="mini-handoff" aria-hidden="true">
          <div class="mini-handoff__header">
            <span class="mini-handoff__title">Project brief</span>
            <span class="mini-handoff__status">ready</span>
          </div>
          <div class="mini-handoff__row"><span></span><span></span><b>Keep</b></div>
          <div class="mini-handoff__row"><span></span><span></span><b>Review</b></div>
          <div class="mini-handoff__footer">Share only what matters</div>
        </div>
      </article>
    </div>
  </section>

  <section id="join" class="join join--paper reveal">
    <div class="wrap join__inner">
      <div>
        <h2 class="join__headline">Get the first invite.</h2>
        <p class="join__body">Join the private beta. We will email you when your invite is ready.</p>
      </div>
      <div class="join__form">
        <WaitlistForm variant="footer" />
      </div>
    </div>
  </section>

  <style>
    .hero {
      display: grid;
      gap: var(--spacing-40);
      padding-block: clamp(var(--spacing-48), 9vw, var(--spacing-96)) var(--spacing-64);
    }

    .hero__content {
      max-width: 62rem;
    }

    .hero__eyebrow {
      display: block;
      margin-bottom: var(--spacing-16);
    }

    .hero__headline {
      max-width: 16ch;
      color: var(--color-charcoal);
      font-size: var(--text-display);
      letter-spacing: var(--tracking-display);
      line-height: var(--leading-display);
    }

    .hero__subhead {
      max-width: 46ch;
      margin-top: var(--spacing-20);
      color: var(--color-steel);
      font-size: var(--text-body-xl);
      line-height: 1.55;
    }

    .feature-pills {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: clamp(var(--spacing-8), 2vw, var(--spacing-24));
      margin: var(--spacing-28) 0 0;
      padding: 0;
      list-style: none;
    }

    .feature-pill {
      display: inline-flex;
      flex: 0 1 auto;
      align-items: center;
      gap: var(--spacing-4);
      min-width: 0;
      padding: 0;
      color: var(--color-charcoal);
      font-size: clamp(0.65rem, 1.05vw, 0.75rem);
      font-weight: 500;
      letter-spacing: -0.015em;
      white-space: nowrap;
      line-height: 1.3;
    }

    @media (max-width: 640px) {
      .feature-pills {
        align-items: flex-start;
        flex-direction: column;
        gap: var(--spacing-8);
      }

      .feature-pill {
        flex: 0 0 auto;
        font-size: 0.75rem;
      }
    }


    .hero__form {
      max-width: 40rem;
      margin-top: var(--spacing-28);
    }

    .workspace-preview {
      width: 100%;
      overflow: hidden;
      border: 1px solid var(--color-blue-wash);
      border-radius: var(--radius-large-card);
      background: var(--color-canvas-white);
      box-shadow: 0 1rem 3rem var(--color-paper-mist);
    }

    .workspace-preview__appbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-16);
      border-bottom: 1px solid var(--color-ash);
      padding: var(--spacing-12) var(--spacing-16);
    }

    .workspace-preview__brand {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-8);
      font-size: var(--text-body);
      font-weight: 600;
    }

    .workspace-preview__mode,
    .workspace-preview__status {
      color: var(--color-deep-sapphire);
      font-size: var(--text-caption);
      font-weight: 600;
      white-space: nowrap;
    }

    .workspace-preview__body {
      display: grid;
      grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
      min-height: 22rem;
    }

    .workspace-preview__sidebar {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-4);
      border-right: 1px solid var(--color-ash);
      background: var(--color-paper-mist);
      padding: var(--spacing-16);
    }

    .workspace-preview__sidebar-label {
      margin-bottom: var(--spacing-8);
    }

    .workspace-preview__nav {
      border-radius: var(--radius-button);
      padding: var(--spacing-8);
      color: var(--color-slate);
      font-size: var(--text-body);
    }

    .workspace-preview__nav--active {
      background: var(--color-blue-wash);
      color: var(--color-deep-sapphire);
      font-weight: 600;
    }

    .workspace-preview__sidebar-foot {
      display: flex;
      align-items: center;
      gap: var(--spacing-8);
      margin-top: auto;
      padding-top: var(--spacing-16);
      color: var(--color-steel);
      font-size: var(--text-caption);
    }

    .workspace-preview__main {
      min-width: 0;
      padding: clamp(var(--spacing-16), 4vw, var(--spacing-32));
    }

    .workspace-preview__toolbar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--spacing-16);
    }

    .workspace-preview h2 {
      margin-top: var(--spacing-4);
      color: var(--color-charcoal);
      font-size: var(--text-heading-sm);
    }

    .workspace-preview__summary {
      display: flex;
      gap: var(--spacing-12);
      margin-top: var(--spacing-24);
      border: 1px solid var(--color-ash);
      border-radius: var(--radius-card);
      background: var(--color-paper-mist);
      padding: var(--spacing-16);
    }

    .workspace-preview__summary strong {
      display: block;
      font-size: var(--text-body);
    }

    .workspace-preview__summary p {
      margin-top: var(--spacing-4);
      color: var(--color-steel);
      font-size: var(--text-body);
    }

    .workspace-preview__rows {
      margin-top: var(--spacing-24);
      border-top: 1px solid var(--color-ash);
    }

    .workspace-preview__row {
      display: grid;
      grid-template-columns: 8px minmax(0, 1fr) auto;
      gap: var(--spacing-12);
      align-items: center;
      min-height: 3.25rem;
      border-bottom: 1px solid var(--color-ash);
      color: var(--color-graphite);
      font-size: var(--text-body);
    }

    .workspace-preview__row-marker {
      color: var(--color-electric-blue);
      font-size: 0.9rem;
    }

    .workspace-preview__sample {
      margin-top: var(--spacing-12);
      color: var(--color-fog);
    }

    .workspace-preview__caption {
      border-top: 1px solid var(--color-ash);
      padding: var(--spacing-12) var(--spacing-16);
      color: var(--color-steel);
      font-size: var(--text-caption);
    }

    .dial-section {
      border-top: 1px solid var(--color-ash);
      border-bottom: 1px solid var(--color-ash);
    }

    .dial-section__inner {
      display: grid;
      gap: var(--spacing-32);
      align-items: center;
      padding-block: clamp(var(--spacing-48), 8vw, var(--spacing-80));
    }

    .dial-section__intro {
      max-width: 28rem;
    }

    .dial-section h2 {
      margin-top: var(--spacing-8);
      color: var(--color-charcoal);
      font-size: var(--text-heading-lg);
      letter-spacing: -0.02em;
    }

    .dial-section__intro > p:last-child {
      margin-top: var(--spacing-12);
      color: var(--color-steel);
    }

    .dial-section__visual {
      min-width: 0;
    }

    .dial-section__caption {
      max-width: 48ch;
      margin: var(--spacing-12) auto 0;
      text-align: center;
    }

    .product-bento {
      display: grid;
      gap: var(--spacing-16);
      padding-block: clamp(var(--spacing-64), 10vw, var(--spacing-112));
    }

    .product-bento__intro {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
      gap: var(--spacing-24);
      align-items: center;
      max-width: 70rem;
      border: 1px solid transparent;
      border-radius: var(--radius-large-card);
      background: linear-gradient(135deg, var(--color-paper-mist), var(--color-canvas-white));
      padding: clamp(var(--spacing-20), 4vw, var(--spacing-40));
      box-shadow: var(--shadow-subtle);
    }

    .product-bento__intro-copy {
      min-width: 0;
    }

    .product-bento__intro h2 {
      max-width: 17ch;
      color: var(--color-charcoal);
      font-size: clamp(2rem, 4vw, 3.25rem);
      letter-spacing: -0.03em;
      line-height: 1.04;
    }

    .product-bento__intro > p:last-child {
      max-width: 34ch;
      color: var(--color-steel);
      font-size: var(--text-body-xl);
    }

    .product-bento__intro-copy > p:last-child {
      max-width: 34ch;
      margin-top: var(--spacing-16);
      color: var(--color-steel);
      font-size: var(--text-body-xl);
    }

    .product-bento__intro-visual {
      display: grid;
      gap: var(--spacing-12);
      align-self: stretch;
      min-height: 10rem;
      border-top: 1px solid var(--color-ash);
      border-bottom: 1px solid var(--color-ash);
      padding-block: var(--spacing-12);
    }

    .intro-visual__header,
    .intro-visual__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--spacing-12);
      align-items: center;
    }

    .intro-visual__header {
      color: var(--color-steel);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-meta);
      text-transform: uppercase;
    }

    .intro-visual__header span:last-child {
      color: var(--color-vivid-green);
    }

    .intro-visual__row {
      grid-template-columns: 1rem minmax(0, 1fr) auto;
      border-top: 1px solid var(--color-paper-mist);
      padding-top: var(--spacing-8);
      color: var(--color-charcoal);
    }

    .intro-visual__row ion-icon {
      color: var(--color-electric-blue);
      font-size: 1rem;
    }

    .intro-visual__row b {
      color: var(--color-steel);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      font-weight: 400;
    }

    .product-bento__grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        "capture capture capture capture capture capture capture privacy privacy privacy privacy privacy"
        "document document document document document handoff handoff handoff handoff handoff handoff handoff";
      grid-template-rows: minmax(28rem, auto) minmax(24rem, auto);
      gap: var(--spacing-16);
    }

    .product-bento__grid {
      display: block;
    }

    .product-card {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
      align-items: center;
      min-height: 0;
      gap: clamp(var(--spacing-24), 6vw, var(--spacing-80));
      border: 0;
      border-top: 1px solid var(--color-ash);
      border-radius: 0;
      background: transparent;
      padding: var(--spacing-32) 0;
      box-shadow: none;
    }

    .product-card:last-child {
      border-bottom: 1px solid var(--color-ash);
    }

    .product-card--capture,
    .product-card--privacy,
    .product-card--document,
    .product-card--handoff {
      grid-area: auto;
      background: transparent;
    }

    .product-card {
      display: flex;
      min-height: 28rem;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--spacing-32);
      overflow: hidden;
      border: 1px solid transparent;
      border-radius: var(--radius-large-card);
      background: var(--color-canvas-white);
      padding: clamp(var(--spacing-20), 3vw, var(--spacing-32));
      box-shadow: var(--shadow-subtle);
      height: 100%;
    }

    .product-card--capture {
      grid-area: capture;
      background: var(--color-orange-wash);
    }

    .product-card--privacy {
      grid-area: privacy;
      background: var(--color-green-wash);
    }

    .product-card--document {
      grid-area: document;
      background: var(--color-violet-wash);
    }

    .product-card--handoff {
      grid-area: handoff;
      background: var(--color-blue-wash);
    }

    .product-card__copy {
      max-width: 32rem;
    }

    .product-card__copy h3 {
      max-width: 13ch;
      margin-top: var(--spacing-12);
      color: var(--color-charcoal);
      font-family: var(--font-satoshi);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.06;
    }

    .product-card__copy > p:last-child {
      max-width: 38ch;
      margin-top: var(--spacing-16);
      color: var(--color-steel);
    }

    .mini-timeline,
    .mini-document {
      position: relative;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .mini-timeline {
      display: grid;
      gap: var(--spacing-12);
      min-height: 12rem;
      padding: var(--spacing-20) var(--spacing-20) var(--spacing-20) var(--spacing-40);
    }

    .mini-timeline__line {
      position: absolute;
      top: var(--spacing-20);
      bottom: var(--spacing-20);
      left: 1.25rem;
      width: 1px;
      background: var(--color-smoke);
    }

    .mini-timeline__event {
      position: relative;
      z-index: 1;
      display: block;
      border-radius: var(--radius-input);
      background: var(--color-paper-mist);
      padding: var(--spacing-8) var(--spacing-12);
      color: var(--color-steel);
      font-size: var(--text-caption);
    }

    .mini-timeline__event::before {
      position: absolute;
      top: 50%;
      left: calc(-1.55rem + 2px);
      width: 9px;
      height: 9px;
      border: 2px solid var(--color-orange-wash);
      border-radius: 50%;
      background: var(--color-tangerine);
      content: "";
      transform: translateY(-50%);
    }

    .mini-timeline__event b {
      margin-right: var(--spacing-8);
      color: var(--color-charcoal);
      font-family: var(--font-geist-mono);
      font-weight: 500;
    }

    .privacy-orbit {
      position: relative;
      display: grid;
      min-height: 12rem;
      place-items: center;
      overflow: hidden;
      border-radius: var(--radius-card);
      background: var(--color-soft-mint);
      transition: transform 360ms var(--ease-out);
    }

    .product-card:hover .privacy-orbit {
      transform: translateY(-3px);
    }

    .privacy-orbit__ring {
      position: absolute;
      width: 9rem;
      height: 9rem;
      border: 1px solid var(--color-vivid-green);
      border-radius: 50%;
      opacity: 0.42;
    }

    .privacy-orbit__ring::after {
