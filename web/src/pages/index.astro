---
import Base from "../layouts/Base.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import ArcDiagram from "../components/ArcDiagram.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
---

<Base
  title="Qaptr — the ten minutes you forget you spent"
  description="Qaptr is a privacy-first macOS menu-bar app that notices the workflows you actually run, and turns the good ones into a reusable document. Join the waitlist."
>
  <header class="site-header wrap">
    <a class="wordmark" href="/">Qaptr</a>
    <a class="cta-pill" href="#join">Join waitlist</a>
  </header>

  <main id="main">
    <section class="hero wrap">
      <p class="mono-label hero-eyebrow">Private beta · macOS, Apple silicon</p>
      <h1 class="hero-headline">Qaptr keeps the ten minutes you forget you spent.</h1>
      <p class="hero-sub">
        A quiet menu-bar app that notices the small workflows behind your real work, and turns
        the ones worth keeping into a document you can hand to a teammate, an automation, or
        yourself in six months.
      </p>
      <WaitlistForm source="hero" id="join-hero" />
    </section>

    <section class="arc-section wrap" aria-labelledby="cadence-heading">
      <p class="mono-label" id="cadence-heading">How it watches</p>
      <ArcDiagram />
      <div class="arc-caption">
        <p>
          Sparse mode takes one screenshot every ten minutes and nothing more. Only when you ask
          Qaptr to look closer at a specific workflow does the interval tighten, visibly, in the
          menu bar, until you turn it back off.
        </p>
      </div>
    </section>

    <section class="passages wrap" aria-label="What Qaptr does and does not do">
      <article class="passage">
        <p class="passage-label">What it captures</p>
        <div>
          <p class="passage-statement">A sparse trail, not a recording.</p>
          <p class="passage-body">
            A downscaled screenshot, the active app, window title, browser hostname, and document
            name — sampled at one instant, never observed continuously. No clipboard, no
            keystrokes, no live accessibility monitoring.
          </p>
        </div>
      </article>

      <article class="passage">
        <p class="passage-label">What it never keeps</p>
        <div>
          <p class="passage-statement">Screenshots are temporary. Your history isn't a photo album.</p>
          <p class="passage-body">
            Every image is processing material with a cache lifetime you choose. When it expires,
            the encryption keys are destroyed and the files unlinked. What survives is a compact
            written summary, never a thumbnail.
          </p>
        </div>
      </article>

      <article class="passage">
        <p class="passage-label">What it becomes</p>
        <div>
          <p class="passage-statement">One Workflow document, written the way you'd write it.</p>
          <p class="passage-body">
            Qaptr turns a recognized pattern into a canonical Workflow — goal, context, tools,
            sequence, decisions — exported as Markdown for automation, handoff, onboarding, or a
            plain SOP. It never launches anything on your behalf.
          </p>
        </div>
      </article>
    </section>

    <section class="closing wrap" id="join">
      <h2 class="closing-headline">Be first to try it.</h2>
      <WaitlistForm source="footer" id="join-footer" />
    </section>
  </main>

  <footer class="site-footer wrap">
    <span>Qaptr — built to be forgotten while it works.</span>
    <span>© 2026 Qaptr. No data is sold, ever.</span>
  </footer>

  <ScrollReveal />
</Base>
