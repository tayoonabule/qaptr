---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import ArcDial from "../components/ArcDial.astro";
---

<BaseLayout title="Qaptr — private beta for macOS">
  <section class="hero wrap">
    <div class="hero__lede">
      <h1 class="hero__headline reveal">Remember what you did without stopping to document it.</h1>
      <p class="hero__sub reveal">
        Qaptr quietly records the shape of your work on your Mac, then gives you a clear draft to review when you are ready.
      </p>

      <div class="hero__form reveal">
        <WaitlistForm variant="hero" />
      </div>
    </div>

    <figure class="pipeline reveal" aria-labelledby="pipeline-caption">
      <div class="pipeline__bar">
        <span class="pipeline__live">
          <span class="pipeline__pulse" aria-hidden="true"></span>
          Capturing
        </span>
        <span class="pipeline__interval">every 5 min</span>
      </div>

      <ol class="pipeline__stages" aria-label="How Qaptr turns a work session into a reviewable record">
        <li class="pipeline__stage">
          <span class="pipeline__node" aria-hidden="true"><ion-icon name="scan-outline"></ion-icon></span>
          <div class="pipeline__body">
            <h2 class="pipeline__title">Captures while you work</h2>
            <div class="pipeline__apps" aria-hidden="true">
              <span class="pipeline__app">Editor</span>
              <span class="pipeline__app">Browser</span>
              <span class="pipeline__app">Notes</span>
              <span class="pipeline__app pipeline__app--off">Excluded</span>
              <span class="pipeline__sweep"></span>
            </div>
          </div>
        </li>

        <li class="pipeline__stage">
          <span class="pipeline__node" aria-hidden="true"><ion-icon name="git-commit-outline"></ion-icon></span>
          <div class="pipeline__body">
            <h2 class="pipeline__title">Assembles the session for you</h2>
            <div class="pipeline__tape" aria-hidden="true">
              <div class="pipeline__event"><b>09:42</b><span>Drafted the brief</span></div>
              <div class="pipeline__event"><b>10:18</b><span>Compared source notes</span></div>
              <div class="pipeline__event"><b>11:06</b><span>Wrote the next step</span></div>
              <p class="pipeline__rollup">14 captures · assembled automatically</p>
            </div>
          </div>
        </li>

        <li class="pipeline__stage">
          <span class="pipeline__node pipeline__node--done" aria-hidden="true"><ion-icon name="checkmark-outline"></ion-icon></span>
          <div class="pipeline__body">
            <h2 class="pipeline__title">Waits for your approval</h2>
            <div class="pipeline__result" aria-hidden="true">
              <span class="pipeline__result-state">ready to review</span>
              <span class="pipeline__action">Review</span>
            </div>
          </div>
        </li>
      </ol>

      <figcaption id="pipeline-caption" class="pipeline__caption">
        <ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon>
        Example session. Nothing leaves this Mac without your approval.
      </figcaption>
    </figure>
  </section>

  <section class="dial-section blueprint-surface radiant-fluid reveal">
    <div class="wrap dial-section__inner">
      <div class="dial-section__intro">
        <p class="meta"><ion-icon name="timer-outline" aria-hidden="true"></ion-icon>Set it once</p>
        <h2>Capture at your pace.</h2>
        <p>Choose how often Qaptr checks in. Keep working. It will build the record quietly.</p>
      </div>
      <div class="dial-section__visual">
        <ArcDial />
        <p class="meta dial-section__caption">
          Set the interval from 5 seconds to 30 minutes. Qaptr captures quietly at the pace you choose.
        </p>
      </div>
    </div>
  </section>

  <section class="product-bento wrap reveal" aria-labelledby="product-bento-title">
    <div class="product-bento__intro">
      <div class="product-bento__intro-copy">
        <p class="meta">From activity to clarity</p>
        <h2 id="product-bento-title">A useful record, not a replay.</h2>
        <p>Qaptr turns the shape of your work into a short, readable timeline you can check before you report, hand off, or share.</p>
      </div>
      <div class="product-bento__intro-visual" aria-hidden="true">
        <div class="intro-visual__header">
          <span>Session record</span>
          <span>Ready to review</span>
        </div>
        <div class="intro-visual__row">
          <ion-icon name="camera-outline"></ion-icon>
          <span>Work captured</span>
          <b>09:42</b>
        </div>
        <div class="intro-visual__row">
          <ion-icon name="document-text-outline"></ion-icon>
          <span>Context organized</span>
          <b>10:18</b>
        </div>
        <div class="intro-visual__row">
          <ion-icon name="checkmark-outline"></ion-icon>
          <span>Ready to share</span>
          <b>11:06</b>
        </div>
      </div>
    </div>

    <div class="product-bento__grid">
      <article class="product-card passage product-card--capture">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="time-outline" aria-hidden="true"></ion-icon>Capture</p>
          <h3>Your work, captured as it happens.</h3>
          <p>Qaptr records the apps and windows that make up your session, so you do not have to reconstruct the day later.</p>
        </div>
        <div class="mini-timeline" aria-hidden="true">
          <span class="mini-timeline__line"></span>
          <span class="mini-timeline__event mini-timeline__event--one"><b>09:42</b> Outlined the brief</span>
          <span class="mini-timeline__event mini-timeline__event--two"><b>10:18</b> Checked source notes</span>
          <span class="mini-timeline__event mini-timeline__event--three"><b>11:06</b> Mapped next step</span>
        </div>
      </article>

      <article class="product-card passage product-card--privacy">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon>Privacy</p>
          <h3>Private until you say otherwise.</h3>
          <p>Your capture stays on this Mac. Nothing is shared automatically.</p>
        </div>
          <div class="privacy-orbit" aria-hidden="true">
          <span class="privacy-orbit__ring"></span>
          <span class="privacy-orbit__lock"><ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon></span>
          <span class="privacy-orbit__label">Private on this Mac</span>
          </div>
      </article>

      <article class="product-card passage product-card--document">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="document-text-outline" aria-hidden="true"></ion-icon>Review</p>
          <h3>Know what happened before you explain it.</h3>
          <p>Open a clear timeline when you need the context, not a pile of screenshots.</p>
        </div>
        <div class="mini-document" aria-hidden="true">
          <span class="mini-document__bar mini-document__bar--wide"></span>
          <span class="mini-document__bar"></span>
          <span class="mini-document__bar mini-document__bar--short"></span>
          <span class="mini-document__rule"></span>
          <span class="mini-document__tag">ready to review</span>
        </div>
      </article>

      <article class="product-card product-card--handoff">
        <div class="product-card__copy">
          <p class="meta"><ion-icon name="share-social-outline" aria-hidden="true"></ion-icon>Share</p>
          <h3>Share the result, not the whole day.</h3>
          <p>Choose the useful parts and turn them into notes for a teammate, a review, or tomorrow.</p>
        </div>
        <div class="mini-handoff" aria-hidden="true">
          <div class="mini-handoff__header">
            <span class="mini-handoff__title">Today&rsquo;s session</span>
            <span class="mini-handoff__status">ready</span>
          </div>
          <div class="mini-handoff__row"><span></span><span></span><b>Keep</b></div>
          <div class="mini-handoff__row"><span></span><span></span><b>Review</b></div>
          <div class="mini-handoff__footer">Share only what matters</div>
        </div>
      </article>
    </div>
  </section>

  <section id="join" class="join join--paper reveal">
    <div class="wrap join__inner">
      <div>
        <h2 class="join__headline">Get the first invite.</h2>
        <p class="join__body">Join the private beta. We will email you when your invite is ready.</p>
      </div>
      <div class="join__form">
        <WaitlistForm variant="footer" />
      </div>
    </div>
  </section>

  <style>
    /* Hallmark · genre: modern-minimal · macrostructure: Narrative Workflow · theme: Qaptr paper (locked tokens.css)
     * hero: H2 Split Diptych · enrichment: glass session panel · nav: unchanged (out of scope)
     * The workflow is stated once, in the panel. Copy on the left is headline + one sentence only;
     * each stage carries a label and an artifact, never a paragraph — the artifact is the explanation.
     * pre-emit critique: P5 H5 E5 S5 R5 V5
     * contrast: pass (40-41) · chrome: pass (47, no re-drawn window bar) · tokens: pass (48) · responsive: pass (34, 49-51)
     */
    .hero {
      display: grid;
      gap: var(--spacing-40);
      align-items: start;
      padding-block: clamp(var(--spacing-40), 5vw, var(--spacing-64)) clamp(var(--spacing-64), 10vw, var(--spacing-96));
    }

    .hero__lede {
      min-width: 0;
      max-width: 34rem;
    }

    .hero__headline {
      max-width: 15ch;
      min-width: 0;
      overflow-wrap: break-word;
      hyphens: none;
      color: var(--color-charcoal);
      font-size: var(--text-display);
      letter-spacing: var(--tracking-display);
      line-height: var(--leading-display);
    }

    .hero__sub {
      max-width: 44ch;
      margin-top: var(--spacing-20);
      color: var(--color-steel);
      font-size: var(--text-body-xl);
      line-height: 1.55;
    }

    .hero__form {
      max-width: 34rem;
      margin-top: var(--spacing-28);
    }

    /* Capture pipeline — the automation itself, shown once, as a quiet running process. */
    .pipeline {
      position: relative;
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--color-blue-wash);
      border-radius: var(--radius-large-card);
      background: linear-gradient(160deg, var(--color-canvas-white), var(--color-paper-mist));
      box-shadow: 0 1rem 3rem var(--color-paper-mist);
    }

    .pipeline__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-12);
      border-bottom: 1px solid var(--color-ash);
      padding: var(--spacing-12) var(--spacing-20);
    }

    .pipeline__live {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-8);
      min-width: 0;
      color: var(--color-green-ink);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-meta);
      line-height: 1;
      text-transform: uppercase;
    }

    .pipeline__pulse {
      flex: 0 0 auto;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-vivid-green);
    }

    .js-motion .pipeline__pulse {
      animation: pipeline-pulse 2400ms var(--ease-in-out) infinite;
    }

    @keyframes pipeline-pulse {
      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.3;
        transform: scale(0.82);
      }
    }

    .pipeline__interval {
      color: var(--color-fog);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-meta);
      line-height: 1;
      white-space: nowrap;
    }

    .pipeline__stages {
      margin: 0;
      padding: var(--spacing-24) var(--spacing-20) var(--spacing-16);
      list-style: none;
    }

    .pipeline__stage {
      position: relative;
      display: grid;
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: var(--spacing-16);
      padding-bottom: var(--spacing-20);
    }

    /* The connector that makes three steps read as one automatic flow. */
    .pipeline__stage::before {
      position: absolute;
      top: 1.75rem;
      bottom: 0.25rem;
      left: 0.875rem;
      width: 1px;
      background: linear-gradient(var(--color-smoke), var(--color-ash));
      content: "";
    }

    .pipeline__stage:last-child {
      padding-bottom: 0;
    }

    .pipeline__stage:last-child::before {
      display: none;
    }

    .pipeline__node {
      display: grid;
      width: 1.75rem;
      height: 1.75rem;
      place-items: center;
      border: 1px solid var(--color-blue-wash);
      border-radius: 50%;
      background: var(--color-canvas-white);
      color: var(--color-electric-blue);
    }

    .pipeline__node ion-icon {
      font-size: 0.9rem;
    }

    .pipeline__node--done {
      border-color: var(--color-vivid-green);
      background: var(--color-soft-mint);
      color: var(--color-green-ink);
    }

    .pipeline__body {
      min-width: 0;
    }

    .pipeline__title {
      color: var(--color-charcoal);
      font-size: var(--text-body-lg);
      font-weight: 600;
      line-height: 1.3;
    }

    .pipeline__apps {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-8);
      overflow: hidden;
      margin-top: var(--spacing-12);
      border-radius: var(--radius-input);
    }

    .pipeline__app {
      border: 1px solid var(--color-ash);
      border-radius: var(--radius-tag);
      background: var(--color-canvas-white);
      padding: var(--spacing-4) var(--spacing-12);
      color: var(--color-slate);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
    }

    .pipeline__app--off {
      border-style: dashed;
      border-color: var(--color-smoke);
      background: transparent;
      color: var(--color-fog);
      text-decoration: line-through;
      text-decoration-color: var(--color-smoke);
    }

    .pipeline__sweep {
      position: absolute;
      inset-block: 0;
      left: 0;
      width: 40%;
      background: linear-gradient(90deg, transparent, rgb(37 99 235 / 0.1), transparent);
      pointer-events: none;
    }

    .js-motion .pipeline__sweep {
      animation: pipeline-sweep 4200ms var(--ease-in-out) infinite;
    }

    @keyframes pipeline-sweep {
      0% {
        transform: translateX(-110%);
      }

      100% {
        transform: translateX(330%);
      }
    }

    .pipeline__tape {
      margin-top: var(--spacing-12);
      border: 1px solid var(--color-ash);
      border-radius: var(--radius-card);
      background: var(--color-canvas-white);
      padding: var(--spacing-4) var(--spacing-12) var(--spacing-8);
    }

    .pipeline__event {
      display: grid;
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: clamp(var(--spacing-8), 1.5vw, var(--spacing-12));
      align-items: baseline;
      padding-block: var(--spacing-8);
    }

    .pipeline__event + .pipeline__event {
      border-top: 1px solid var(--color-ash);
    }

    .pipeline__event b {
      color: var(--color-fog);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      font-variant-numeric: tabular-nums;
      font-weight: 400;
    }

    .pipeline__event span {
      min-width: 0;
      color: var(--color-charcoal);
      font-size: var(--text-body);
      line-height: 1.4;
    }

    .pipeline__rollup {
      margin-top: var(--spacing-4);
      border-top: 1px solid var(--color-ash);
      padding-top: var(--spacing-8);
      color: var(--color-deep-sapphire);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-meta);
    }

    .pipeline__result {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-12);
      margin-top: var(--spacing-12);
      border: 1px solid var(--color-vivid-green);
      border-radius: var(--radius-card);
      background: var(--color-green-wash);
      padding: var(--spacing-12) var(--spacing-16);
    }

    .pipeline__result-state {
      color: var(--color-green-ink);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-meta);
      text-transform: uppercase;
    }

    .pipeline__action {
      border: 1px solid var(--color-primary-action-fill);
      border-radius: var(--radius-button);
      background: var(--color-primary-action-fill);
      padding: var(--spacing-4) var(--spacing-12);
      color: var(--color-canvas-white);
      font-size: var(--text-caption);
      font-weight: 600;
    }

    /* No max-width here: the rule above the caption should span the whole panel. */
    .pipeline__caption {
      display: flex;
      align-items: center;
      gap: var(--spacing-8);
      border-top: 1px solid var(--color-ash);
      padding: var(--spacing-12) var(--spacing-20);
      color: var(--color-steel);
      font-size: var(--text-caption);
      line-height: 1.5;
    }

    .pipeline__caption ion-icon {
      flex: 0 0 auto;
      color: var(--color-green-ink);
      font-size: 0.9rem;
    }

    @media (max-width: 360px) {
      .pipeline__bar {
        align-items: flex-start;
        flex-direction: column;
        gap: var(--spacing-8);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .js-motion .pipeline__pulse,
      .js-motion .pipeline__sweep {
        animation: none;
      }

      .pipeline__sweep {
        display: none;
      }
    }

    .dial-section {
      border-top: 1px solid var(--color-ash);
      border-bottom: 1px solid var(--color-ash);
    }

    .dial-section__inner {
      display: grid;
      gap: var(--spacing-32);
      align-items: center;
      padding-block: clamp(var(--spacing-48), 8vw, var(--spacing-80));
    }

    .dial-section__intro {
      max-width: 28rem;
    }

    .dial-section h2 {
      margin-top: var(--spacing-8);
      color: var(--color-charcoal);
      font-size: var(--text-heading-lg);
      line-height: var(--leading-headline);
      letter-spacing: -0.02em;
    }

    .dial-section__intro > p:last-child {
      margin-top: var(--spacing-12);
      color: var(--color-steel);
    }

    .dial-section__visual {
      min-width: 0;
    }

    .dial-section__caption {
      max-width: 48ch;
      margin: var(--spacing-12) auto 0;
      text-align: center;
    }

    .product-bento {
      display: grid;
      gap: var(--spacing-16);
      padding-block: clamp(var(--spacing-64), 10vw, var(--spacing-112));
    }

    .product-bento__intro {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
      gap: var(--spacing-24);
      align-items: center;
      max-width: 70rem;
      border: 1px solid transparent;
      border-radius: var(--radius-large-card);
      background: linear-gradient(135deg, var(--color-paper-mist), var(--color-canvas-white));
      padding: clamp(var(--spacing-20), 4vw, var(--spacing-40));
      box-shadow: var(--shadow-subtle);
    }

    .product-bento__intro-copy {
      min-width: 0;
    }

    .product-bento__intro h2 {
      max-width: 17ch;
      color: var(--color-charcoal);
      font-size: clamp(2rem, 4vw, 3.25rem);
      letter-spacing: -0.03em;
      line-height: 1.04;
    }

    .product-bento__intro > p:last-child {
      max-width: 34ch;
      color: var(--color-steel);
      font-size: var(--text-body-xl);
    }

    .product-bento__intro-copy > p:last-child {
      max-width: 34ch;
      margin-top: var(--spacing-16);
      color: var(--color-steel);
      font-size: var(--text-body-xl);
    }

    .product-bento__intro-visual {
      display: grid;
      gap: var(--spacing-12);
      align-self: stretch;
      min-height: 10rem;
      border-top: 1px solid var(--color-ash);
      border-bottom: 1px solid var(--color-ash);
      padding-block: var(--spacing-12);
    }

    .intro-visual__header,
    .intro-visual__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--spacing-12);
      align-items: center;
    }

    .intro-visual__header {
      color: var(--color-steel);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-meta);
      text-transform: uppercase;
    }

    .intro-visual__header span:last-child {
      color: var(--color-vivid-green);
    }

    .intro-visual__row {
      grid-template-columns: 1rem minmax(0, 1fr) auto;
      border-top: 1px solid var(--color-paper-mist);
      padding-top: var(--spacing-8);
      color: var(--color-charcoal);
    }

    .intro-visual__row ion-icon {
      color: var(--color-electric-blue);
      font-size: 1rem;
    }

    .intro-visual__row b {
      color: var(--color-steel);
      font-family: var(--font-geist-mono);
      font-size: var(--text-caption);
      font-weight: 400;
    }

    .product-bento__grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        "capture capture capture capture capture capture capture privacy privacy privacy privacy privacy"
        "document document document document document handoff handoff handoff handoff handoff handoff handoff";
      grid-template-rows: minmax(28rem, auto) minmax(24rem, auto);
      gap: var(--spacing-16);
    }

    .product-bento__grid {
      display: block;
    }

    .product-card {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
      align-items: center;
      min-height: 0;
      gap: clamp(var(--spacing-24), 6vw, var(--spacing-80));
      border: 0;
      border-top: 1px solid var(--color-ash);
      border-radius: 0;
      background: transparent;
      padding: clamp(var(--spacing-48), 7vw, var(--spacing-80)) 0;
      box-shadow: none;
    }

    .product-card:last-child {
      border-bottom: 1px solid var(--color-ash);
    }

    .product-card--capture,
    .product-card--privacy,
    .product-card--document,
    .product-card--handoff {
      grid-area: auto;
      background: transparent;
    }

    .product-card {
      display: flex;
      min-height: 28rem;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--spacing-32);
      overflow: hidden;
      border: 1px solid transparent;
      border-radius: var(--radius-large-card);
      background: var(--color-canvas-white);
      padding: clamp(var(--spacing-20), 3vw, var(--spacing-32));
      box-shadow: var(--shadow-subtle);
      height: 100%;
    }

    .product-card--capture {
      grid-area: capture;
      background: var(--color-orange-wash);
    }

    .product-card--privacy {
      grid-area: privacy;
      background: var(--color-green-wash);
    }

    .product-card--document {
      grid-area: document;
      background: var(--color-violet-wash);
    }

    .product-card--handoff {
      grid-area: handoff;
      background: var(--color-blue-wash);
    }

    .product-card__copy {
