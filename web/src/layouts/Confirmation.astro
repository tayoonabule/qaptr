---
import Base from "./Base.astro";
import WaitlistForm from "../components/WaitlistForm.astro";

export interface Props {
  title: string;
  heading: string;
  tone: "success" | "error";
  body: string;
  allowRetry?: boolean;
}

const { title, heading, tone, body, allowRetry = false } = Astro.props;
---

<Base title={`${title} - Qaptr`} description={body}>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="Qaptr home">
      <span class="wordmark-mark" aria-hidden="true">Q</span>
      <span>Qaptr</span>
    </a>
  </header>

  <main id="main" class="wrap confirmation" data-tone={tone}>
    <p class="confirmation-kicker" data-tone={tone}>{tone === "success" ? "Waitlist" : "Waitlist not saved"}</p>
    <h1 class="confirmation-heading">{heading}</h1>
    <p class="confirmation-body">{body}</p>
    {allowRetry ? (
      <div class="confirmation-retry">
        <WaitlistForm source="hero" id="retry-waitlist" autoFocus />
        <a class="text-action" href="/#join">Read about Qaptr</a>
      </div>
    ) : (
      <a class="header-action" href="/#join">Back to Qaptr</a>
    )}
  </main>

  <footer class="site-footer wrap">
    <span>Qaptr, built to be quiet while it works.</span>
    <span>© 2026 Qaptr. No data is sold.</span>
  </footer>
</Base>
