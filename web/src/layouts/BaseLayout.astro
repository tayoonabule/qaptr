---
import "../styles/base.css";

interface Props {
  title: string;
  description?: string;
}

  const { title, description = "Qaptr quietly records your work on Mac, then gives you a clear timeline to review and share." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/qaptr-aperture.svg" />
    <script is:inline type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script is:inline nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="site-header__mark" href="/" aria-label="Qaptr home">
          <ion-icon name="aperture-outline" aria-hidden="true"></ion-icon>
          <span>Qaptr</span>
        </a>
        <a class="site-header__cta animate-ui-button" href="/#join">
          <span>Join the waitlist</span>
          <ion-icon name="arrow-forward-outline" aria-hidden="true"></ion-icon>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__row">
        <span class="site-footer__mark">
          <ion-icon name="aperture-outline" aria-hidden="true"></ion-icon>
          Qaptr
        </span>
        <p class="meta site-footer__privacy">
          <ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon>
          Your email is used only for the waitlist. No tracking.
        </p>
        <span class="meta">{new Date().getFullYear()}</span>
      </div>
    </footer>

    <script>
      // Progressive enhancement only. The page is fully functional and
      // fully visible with this script absent (see .js-motion in base.css).
      document.documentElement.classList.add("js-motion");

      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!prefersReduced && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        document.querySelectorAll(".reveal").forEach((el, index) => {
          if (el instanceof HTMLElement) {
            el.style.setProperty("--reveal-index", String(index % 5));
          }
          io.observe(el);
        });
      } else {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      }

      const dialSection = document.querySelector(".dial-section");
      const dial = document.querySelector("[data-arc-dial]");
      if (!prefersReduced && dialSection instanceof HTMLElement && dial instanceof HTMLElement) {
        let frame = 0;
        const updateDial = () => {
          frame = 0;
          const bounds = dialSection.getBoundingClientRect();
          const travel = Math.max(bounds.height + window.innerHeight * 0.4, 1);
          const progress = Math.min(1, Math.max(0, (window.innerHeight * 0.72 - bounds.top) / travel));
          const angle = -80 + progress * 160;
          dial.style.setProperty("--dial-angle", `${angle}deg`);
        };
        const requestDialUpdate = () => {
          if (!frame) frame = window.requestAnimationFrame(updateDial);
        };
        window.addEventListener("scroll", requestDialUpdate, { passive: true });
        window.addEventListener("resize", requestDialUpdate);
        updateDial();
      }

      document.querySelectorAll("form[data-waitlist-form]").forEach((form) => {
        form.addEventListener("submit", () => {
          const submit = form.querySelector("button[type='submit']");
          if (!(submit instanceof HTMLButtonElement)) return;
          form.setAttribute("data-submitting", "true");
          submit.disabled = true;
          const label = submit.querySelector("span");
          if (label) label.textContent = "Joining…";
        });
      });

    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid var(--color-ash);
        background: var(--color-canvas-white);
      }

      .site-header__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: var(--spacing-16);
        gap: var(--spacing-16);
      }

      .site-header__mark {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-8);
        color: var(--color-charcoal);
        font-family: var(--font-satoshi);
        font-size: var(--text-heading-sm);
        font-weight: 500;
        text-decoration: none;
        letter-spacing: -0.02em;
      }

      .site-header__mark-dot,
      .site-footer__mark-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-electric-blue);
      }

      .site-header__mark ion-icon,
      .site-footer__mark ion-icon {
        color: var(--color-electric-blue);
        font-size: 1.725rem;
      }

      .site-header__cta ion-icon,
      .site-footer__privacy ion-icon {
        margin-left: var(--spacing-8);
        font-size: 1rem;
        vertical-align: -0.15em;
      }

      .site-header__cta {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        border: 1px solid var(--color-primary-action-fill);
        border-radius: var(--radius-button);
        background: var(--color-primary-action-fill);
        color: var(--color-canvas-white);
        padding: var(--spacing-8) var(--spacing-16);
        font-size: var(--text-body);
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out), transform 160ms var(--ease-out);
      }

      .site-header__cta:hover,
      .site-header__cta:focus-visible {
        border-color: var(--color-deep-sapphire);
        background: var(--color-deep-sapphire);
      }

      .site-header__cta:active {
        transform: translateY(1px);
      }

      .site-footer {
        border-top: 1px solid var(--color-ash);
        margin-top: 0;
        background: var(--color-paper-mist);
      }

      .site-footer__row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-16);
        padding-block: var(--spacing-24);
      }

      .site-footer__mark {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-8);
        font-family: var(--font-satoshi);
        font-size: var(--text-subheading);
        font-weight: 500;
      }

      .site-footer__privacy {
        flex: 1 1 18rem;
        min-width: 0;
        text-align: center;
      }

      @media (max-width: 480px) {
        .site-footer__row {
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          gap: var(--spacing-12);
        }

        .site-footer__privacy {
          flex: 0 0 auto;
          width: 100%;
          max-width: 22rem;
        }
      }
    </style>
  </body>
</html>
